# Copy to .env.local for local development, and set the same values
# in the Vercel dashboard for Production/Preview/Development. See
# CONTACT_FORM_SETUP.md for how to get each value.

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Jira credentials — shared by both forms, each targeting its own project
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Waitlist -> Lead Tracking project
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task

# Volunteer -> Applicant pipeline project (resume attached directly to the issue)
VOLUNTEER_JIRA_PROJECT_KEY=
VOLUNTEER_JIRA_ISSUE_TYPE=Task

# Google Workspace SMTP — sends a best-effort "we got it" confirmation email
# to the applicant on both forms. GMAIL_USER is the mailbox that sends the
# email (e.g. contact@yourdomain.org); GMAIL_APP_PASSWORD is an app password
# for that mailbox, not its login password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Entwine

# Optional: comma-separated list of origins allowed to POST to
# /api/submit-form. Leave unset to skip the check.
CONTACT_FORM_ALLOWED_ORIGINS=
